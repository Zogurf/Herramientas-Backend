# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE: BACKEND (Herramientas-Backend)
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# Server Configuration
PORT=8080

# Insforge Cloud PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://your-insforge-host:5432/insforge?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Secret & Token Expiration Settings
JWT_SECRET=your_64_character_hex_secret_key_here
JWT_EXPIRATION=86400000
