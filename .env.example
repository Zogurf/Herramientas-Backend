# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE: BACKEND (Herramientas-Backend)
# Copy this file to .env and fill in your actual credentials.
# Nunca subas el .env real al repositorio.
# =============================================================================

# Server Configuration
PORT=8080

# Insforge Cloud PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://your-insforge-host:5432/insforge?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here

# El esquema SQL es la fuente de verdad. Deja SIEMPRE `none`: con `update`
# Hibernate alteraría auth_schema y store_schema en cada arranque.
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Secret & Token Expiration Settings
# Se usa directamente como bytes UTF-8: cualquier cadena larga y aleatoria sirve.
JWT_SECRET=your_64_character_hex_secret_key_here
JWT_EXPIRATION=86400000

# Google OAuth2 (verificación del ID token en POST /api/v1/auth/google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# El backend actual no consume el secret (solo verifica el ID token por HTTP
# contra Google); se mantiene por si se migra a un flujo con código de autorización.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook Login (verificación del access token en POST /api/v1/auth/facebook)
# "Client ID" / "Client Secret" son el App ID y el App Secret de Meta. Ambas son
# obligatorias para que el endpoint funcione: el Client Secret se usa para
# comprobar que el token pertenece a esta app (debug_token con id|secret).
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
# Versión de la Graph API. Súbela cuando Meta deprecie la actual.
FACEBOOK_API_VERSION=v26.0

# Gmail SMTP (correos de recuperación de contraseña)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# URL pública del frontend, para los enlaces de recuperación (sin barra final)
FRONTEND_URL=http://localhost:3000

# CORS: orígenes permitidos, separados por comas (admite patrones como https://*.onrender.com)
# En local no hace falta definirlo: el valor por defecto permite localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
